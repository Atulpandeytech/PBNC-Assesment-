# Application Configuration
APP_NAME=PragatiBhartiDocumentIntelligence
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# In Docker/Production: postgresql+asyncpg://postgres:postgres@postgres:5432/pragati_bharti
# In Local Test/Dev: sqlite+aiosqlite:///./data/pragati_bharti.db
DATABASE_URL=sqlite+aiosqlite:///./data/pragati_bharti.db

# Redis & Queue Configuration
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Storage Configuration
# Options: local, s3
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
MAX_PAGE_COUNT=100

# OCR & AI Providers
TESSERACT_CMD=
LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Processing & Confidence Thresholds
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_LOW=0.60
WORKER_CONCURRENCY=4
