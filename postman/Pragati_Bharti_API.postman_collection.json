{
  "info": {
    "_postman_id": "7f62c823-74b8-4d5f-9e63-c7ad06ba55d2",
    "name": "Pragati Bharti - Document Intelligence & Question Extraction API",
    "description": "Production-grade REST API collection for Pragati Bharti education platform. Covers authentication, multi-tenant document ingestion, async extraction pipeline monitoring, question review/correction workflow, cross-document answer key merging, and format export.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
