              "raw": "{{base_url}}/answers/?document_id={{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["answers", ""],
              "query": [
                { "key": "document_id", "value": "{{document_id}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Specific Answer Key Entry",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/answers/{{answer_id}}",
              "host": ["{{base_url}}"],
              "path": ["answers", "{{answer_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Patch Answer Key Entry",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correct_option\": \"C\",\n  \"explanation\": \"Updated verified explanation.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/answers/{{answer_id}}",
              "host": ["{{base_url}}"],
              "path": ["answers", "{{answer_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Cross-Document Linking (Groups)",
      "item": [
        {
          "name": "Create Document Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set(\"group_id\", jsonData.id);",
                  "    console.log(\"Saved group_id:\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CBSE Physics Term 1 Paper & Key\",\n  \"description\": \"Question paper and standalone official answer key pairing.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/groups/",
              "host": ["{{base_url}}"],
              "path": ["groups", ""]
            }
          },
          "response": []
        },
        {
          "name": "List Document Groups",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/groups/?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["groups", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Group Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/groups/{{group_id}}",
              "host": ["{{base_url}}"],
              "path": ["groups", "{{group_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Link Document to Group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_id\": \"{{document_id}}\",\n  \"role\": \"question_paper\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/groups/{{group_id}}/documents",
              "host": ["{{base_url}}"],
              "path": ["groups", "{{group_id}}", "documents"]
            }
          },
          "response": []
        },
        {
          "name": "Merge Group (Link Question Paper with Answer Key)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/groups/{{group_id}}/merge",
              "host": ["{{base_url}}"],
              "path": ["groups", "{{group_id}}", "merge"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Document Group",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/groups/{{group_id}}",
              "host": ["{{base_url}}"],
              "path": ["groups", "{{group_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "7. Warnings & Document Quality",
      "item": [
        {
          "name": "List Warnings for Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/warnings/?document_id={{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["warnings", ""],
              "query": [
                { "key": "document_id", "value": "{{document_id}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Warning Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/warnings/{{warning_id}}",
              "host": ["{{base_url}}"],
              "path": ["warnings", "{{warning_id}}"]
            }
